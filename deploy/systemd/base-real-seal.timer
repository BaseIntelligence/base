[Unit]
Description=Seal the current chain epoch on the master gateway (real weights)

[Timer]
# 10 min cadence: both challenges emit within minutes of an epoch boundary /
# round close, so the current epoch becomes sealable well before it ends
# (~72 min at tempo 360). The endpoint 409s harmlessly until both sets land.
OnBootSec=5min
OnUnitActiveSec=10min
Persistent=true

[Install]
WantedBy=timers.target
