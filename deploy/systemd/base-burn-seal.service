[Unit]
Description=BASE interim prod burn-seal (fresh sealed weights bundle on master gateway)
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/opt/base/bin/weights-smoke

[Service]
Type=oneshot
ExecStart=/opt/base/deploy/scripts/prod-burn-seal.sh
Nice=10
TimeoutStartSec=180
# Ordered chain endpoint failover for the weights-smoke tip/metagraph reads
# (entrypoint-finney primary again — recovered 2026-08-07 after the
# 2026-08-06 429 window; onfinality public-ws is the fallback).
Environment=BASE_CHAIN_ENDPOINTS=wss://entrypoint-finney.opentensor.ai:443,wss://bittensor-finney.api.onfinality.io/public-ws
