[Unit]
Description=BASE interim prod burn-seal (fresh sealed weights bundle on master gateway)
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/opt/base/bin/weights-smoke

[Service]
Type=oneshot
ExecStart=/opt/base/deploy/scripts/prod-burn-seal.sh
Nice=10
TimeoutStartSec=180
# Ordered chain endpoint failover for the weights-smoke tip/metagraph reads
# (onfinality primary; entrypoint-finney rate-limited this host 2026-08-06).
Environment=BASE_CHAIN_ENDPOINTS=wss://bittensor-finney.api.onfinality.io/public-ws,wss://entrypoint-finney.opentensor.ai:443
