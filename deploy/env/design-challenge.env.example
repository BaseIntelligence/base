# operator-managed, never committed to git.
# Design challenge orchestration surface (env file, not inline).

# Fail-closed for real dispatch: no DB → in-memory store (dev only).
# Must match deploy/env/postgres.env on the host (see postgres.env.example).
BASE_DATABASE_URL=postgres://base:base_dev_only_change_me@postgres:5432/base
BASE_NETUID=541
# Live chain; default falls back to finney testnet.
# BASE_CHAIN_ENDPOINT=wss://test.finney.opentensor.ai:443

# Orchestrator knobs (defaults in place).
# DESIGN_MAX_CONCURRENT=2
# DESIGN_FORCE_SIM=false
# DESIGN_FRAME_ANCESTORS='none'

# Sandbox talks to Docker via socket-proxy; staging root must match the host
# bind path used in docker-compose.yml (daemon resolves binds on the host).
# DESIGN_DOCKER_BASE=http://socket-proxy:2375
# DESIGN_STAGING_ROOT=/var/lib/base/design/staging
# DESIGN_LLM_PROXY=http://design-egress-proxy:8094

# Annotator / admin bearer tokens: one per line in deploy/secrets/design/annotator_tokens
# (hashed at boot). Empty file → admin API rejects all tokens.
# Optional override: DESIGN_ADMIN_TOKENS_FILE=...
# Agentic review: DESIGN_AGENTIC_OPENROUTER_KEY_FILE=/run/base/openrouter/api_key
# (missing key → SimAgent). CI: DESIGN_FORCE_AGENTIC_SIM=1
