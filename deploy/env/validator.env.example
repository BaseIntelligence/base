# Placeholder / local-dev only. Production: age-decrypt to validator.env mode 0600.
BASE_ROLE=validator
BASE_NETUID=1
# Must match deploy/env/postgres.env (POSTGRES_USER/PASSWORD/DB).
BASE_DATABASE_URL=postgres://base:base_dev_only_change_me@postgres:5432/base
# Prefer file mount in prod:
# BASE_DATABASE_URL_FILE=/run/base/database_url

# Live Bittensor endpoint. There is no fake backend: the validator exits
# non-zero if it cannot reach the chain or resolve the subnet.
BASE_CHAIN_ENDPOINT=wss://test.finney.opentensor.ai:443

# Gateway to read sealed bundles from (master's VPC address on a validator host).
# BASE_GATEWAY_ENDPOINT=http://10.116.0.2:8080

# --- Hotkey (optional) ----------------------------------------------------
# Only used for the D10 report_data binding on attestation. Unset means zeros.
BT_WALLETS_PATH=/run/base/wallets
BASE_VALIDATOR_WALLET=base-validator
BASE_VALIDATOR_WALLET_HOTKEY=default
#   BASE_VALIDATOR_MNEMONIC_FILE=/run/base/validator_mnemonic
#   BASE_VALIDATOR_SK_FILE=/run/base/validator_sk
#   BASE_VALIDATOR_HOTKEY=<64 hex chars or an SS58 address>

# Quote verifier: `dcap` = real Intel DCAP, `mock_ok` = accept everything
# (development only, logs a warning), `park` = simulate a PCS outage.
BASE_ATTEST_VERIFIER=dcap
