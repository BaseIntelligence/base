# Placeholder / local-dev only. Production: age-decrypt to gateway.env mode 0600.
BASE_ROLE=gateway
BASE_NETUID=1
BASE_DOMAIN=example.com
# Must match deploy/env/postgres.env (POSTGRES_USER/PASSWORD/DB).
BASE_DATABASE_URL=postgres://base:base_dev_only_change_me@postgres:5432/base

# Live Bittensor endpoint. There is no fake backend: the gateway always talks to
# a real chain and exits non-zero if it cannot connect.
BASE_CHAIN_ENDPOINT=wss://test.finney.opentensor.ai:443
# Optional ordered failover list (comma-separated); wins over BASE_CHAIN_ENDPOINT.
# A rate-limited/unreachable endpoint cools 60s, then the next in order serves.
# BASE_CHAIN_ENDPOINTS=wss://bittensor-finney.api.onfinality.io/public-ws,wss://entrypoint-finney.opentensor.ai:443

# --- Hotkey ---------------------------------------------------------------
# Preferred: a standard Bittensor wallet (the btcli on-disk format). The
# hotkey file holds a BIP39 `secretPhrase`, which is derived to sr25519 using
# the Substrate scheme (PBKDF2-HMAC-SHA512 over the BIP39 entropy).
BT_WALLETS_PATH=/run/base/wallets
BASE_GATEWAY_WALLET=base-owner
BASE_GATEWAY_WALLET_HOTKEY=default
#
# Alternatives (first match wins):
#   BASE_GATEWAY_MNEMONIC_FILE=/run/base/gateway_mnemonic   # mode 0600 or stricter
#   BASE_GATEWAY_SK_FILE=/run/base/gateway_sk               # 32 raw bytes or 64 hex
#   BASE_GATEWAY_HOTKEY=<64 hex chars or an SS58 address>   # public only
#
# Set to 1 to refuse startup unless the resolved hotkey is the on-chain
# SubnetOwnerHotkey for BASE_NETUID. Default (unset/0) only logs a warning.
BASE_GATEWAY_REQUIRE_OWNER=0
#
# When REQUIRE_OWNER=1, one of these MUST be set (fail-closed): Bearer auth for
# /v1/admin/* (seal, backend registry, attest-grant). Prefer the file form.
# BASE_GATEWAY_ADMIN_TOKEN_FILE=/run/secrets/gateway_admin_token
# BASE_GATEWAY_ADMIN_TOKEN=
