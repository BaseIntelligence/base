# Placeholder / local-dev only. Production: age-decrypt to agent-challenge.env
# mode 0600.
#
# Only needed when BASE_CHALLENGE_DISPATCH=1. The epoch driver records every
# dispatch, receipt and attestation outcome in the control-plane database, and
# refuses to start without one rather than run an epoch it cannot account for.
# Point it at the same database the gateway and validators use.
BASE_DATABASE_URL=**********************************/base
# Prefer a file mount in prod:
# BASE_DATABASE_URL_FILE=/run/base/database_url
