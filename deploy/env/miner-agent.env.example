# Local miner runtime (testnet, no TEE) — non-secret runtime config.
# Consumed by the `miner-agent` service (deploy/compose/role-master.yml).
# Secrets live only in deploy/secrets/agent/receipt_sk (mode 0400, uid 65532).

# Trusted challenge public key (64 lowercase hex). The runner refuses signed
# dispatches signed by any other key. Derive it from the challenge secret:
#   docker compose -f docker-compose.yml -f deploy/compose/role-master.yml \
#     run --rm agent-challenge identity --challenge-sk-file /run/base/challenge_sk
# (prints public_key=<hex>)
BASE_TRUSTED_CHALLENGE_PUBKEY=

# Optional operator agent command, a JSON array of strings, validated by the
# runner at boot. Omitted, the built-in reference placeholder command runs.
# BASE_AGENT_CMD=["python3","/workspace/agent.py"]
