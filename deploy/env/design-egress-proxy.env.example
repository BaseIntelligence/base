# operator-managed, never committed to git.
# Design sandbox egress proxy: open Internet egress for install + run phases
# with an internal-target blocklist (cloud metadata, loopback, RFC1918/VPC,
# CGNAT, control-plane service names — enforced after DNS resolution), plus
# the budgeted OpenRouter chat path used by the harness SDK.

# DESIGN_EGRESS_BIND=0.0.0.0:8094
# DESIGN_TOKEN_BUDGET=8000

# OpenRouter key lives at deploy/secrets/openrouter/api_key (mounted RO).
# Without a key, set DESIGN_EGRESS_SIM=true for deterministic stub replies.
# DESIGN_EGRESS_SIM=false
