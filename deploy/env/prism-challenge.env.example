# operator-managed, never committed to git.
# PRISM challenge orchestration surface (AGENT pattern: env file, not inline).

# Compose requires this file. Submissions persist to Postgres when set.
# Omit only for unit/integration tests that construct MemoryPrismStore directly.
# Must match deploy/env/postgres.env on the host (see postgres.env.example).
BASE_DATABASE_URL=postgres://base:base_dev_only_change_me@postgres:5432/base
BASE_NETUID=541
# Live chain; default falls back to finney testnet.
# BASE_CHAIN_ENDPOINT=wss://test.finney.opentensor.ai:443
# Optional ordered failover list (comma-separated); wins over BASE_CHAIN_ENDPOINT.
# BASE_CHAIN_ENDPOINTS=wss://bittensor-finney.api.onfinality.io/public-ws,wss://entrypoint-finney.opentensor.ai:443

# Orchestrator knobs (defaults in place).
# PRISM_MAX_CONCURRENT_EVALS=1
# PRISM_DATASET_SHA256=<256-hex pin override for the fineweb-edu shard>

# LLM reviewer: lives by OPENROUTER_API_KEY_FILE mount (see
# deploy/secrets/openrouter/api_key). Without a key the reviewer runs in the
# deterministic `sim` mode — no score is invented either way.
