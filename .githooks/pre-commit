#!/usr/bin/env bash
# Fast local gate: rustfmt check + cargo check on the workspace.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

if ! command -v cargo >/dev/null 2>&1; then
  echo "pre-commit: cargo not found on PATH" >&2
  exit 1
fi

echo "pre-commit: cargo fmt --check"
cargo fmt --all -- --check

echo "pre-commit: cargo check --workspace"
cargo check --workspace --all-targets

echo "pre-commit: ok"
