#!/usr/bin/env bash
# Local gate: cargo check (no identity checks).
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
cd "$root"
if ! command -v cargo >/dev/null 2>&1; then
  echo "pre-commit: cargo not found on PATH" >&2
  exit 1
fi
echo "pre-commit: cargo check --workspace --all-targets"
cargo check --workspace --all-targets
echo "pre-commit: ok"
