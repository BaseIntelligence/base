{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT epoch, revision, payload,\n               (EXTRACT(EPOCH FROM created_at) * 1000000)::bigint AS \"sealed_at_micros!\"\n        FROM epoch_bundle\n        WHERE epoch = $1\n        ORDER BY revision DESC\n        LIMIT 1\n        ",
