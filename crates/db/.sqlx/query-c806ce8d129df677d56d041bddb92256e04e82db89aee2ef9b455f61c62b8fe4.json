{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT epoch, revision, payload,\n               (EXTRACT(EPOCH FROM created_at) * 1000000)::bigint AS \"sealed_at_micros!\"\n        FROM epoch_bundle\n        WHERE merkle_root = $1\n        ORDER BY epoch DESC, revision DESC\n        LIMIT 1\n        ",
