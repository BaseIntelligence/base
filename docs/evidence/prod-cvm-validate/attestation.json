    "app_compose": "{\"allowed_envs\":[\"DSTACK_AUTHORIZED_KEYS\"],\"docker_compose_file\":\"# base miner CVM — residual live (challenge_scoring_version=2)\\n# Secrets: file mounts under /run/base only.\\n# Exec: stub (omit docker triad). socket-proxy kept measured for layout/hash.\\nservices:\\n  socket-proxy:\\n    image: tecnativa/docker-socket-proxy@sha256:1f5038b54f06c3e18422902cf00ba21803d1c97805aae032e5e6673d532d3459\\n    restart: unless-stopped\\n    environment:\\n      CONTAINERS: \\\"1\\\"\\n      IMAGES: \\\"1\\\"\\n      POST: \\\"1\\\"\\n      ALLOW_START: \\\"1\\\"\\n      ALLOW_STOP: \\\"1\\\"\\n      NETWORKS: \\\"1\\\"\\n      INFO: \\\"1\\\"\\n      AUTH: \\\"0\\\"\\n      BUILD: \\\"0\\\"\\n      EXEC: \\\"0\\\"\\n      VOLUMES: \\\"0\\\"\\n      SWARM: \\\"0\\\"\\n      SERVICES: \\\"0\\\"\\n      SYSTEM: \\\"0\\\"\\n    volumes:\\n      - /var/run/docker.sock:/var/run/docker.sock:ro\\n  agent:\\n    image: ghcr.io/baseintelligence/base/base-agent@sha256:b92468cc4e619e6975c3b4d8774547323a2a9efcb9a6140c49774f6e2b0c1102\\n    restart: unless-stopped\\n    depends_on:\\n      - socket-proxy\\n    ports:\\n      - \\\"8080:8080\\\"\\n    environment:\\n      BASE_NETUID: \\\"1\\\"\\n      BASE_MINER_HOTKEY_FILE: \\\"/run/base/miner_hotkey\\\"\\n      BASE_LAUNCH_TOKEN_HASH: \\\"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\\\"\\n      BASE_RECEIPT_SK_FILE: \\\"/run/base/receipt_sk\\\"\\n      BASE_RECEIPT_PUBLIC_KEY: \\\"a0464947d2669f0eddbcdb1329209c4302963b81e5bf181b9af27998fba08438\\\"\\n      BASE_TRUSTED_CHALLENGE_PUBKEY: \\\"f2e4965a6a99b75b4212bd45790c496e9665c0e1247e373d9dca3b36413fbd45\\\"\\n    volumes:\\n      - type: bind\\n        source: miner_hotkey\\n        target: /run/base/miner_hotkey\\n        read_only: true\\n      - type: bind\\n        source: launch_token\\n        target: /run/base/launch_token\\n        read_only: true\\n      - type: bind\\n        source: receipt_sk\\n        target: /run/base/receipt_sk\\n        read_only: true\\n  attest-helper:\\n    image: ghcr.io/baseintelligence/base/base-attest-helper@sha256:deb28d9dfd43d735372e177b6b621730bf145a2069b67f420aa07db18689e0bf\\n    restart: unless-stopped\\n    ports:\\n      - \\\"127.0.0.1:8081:8081\\\"\\n    environment:\\n      BASE_LAUNCH_TOKEN_HASH: \\\"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\\\"\\n      BASE_MINER_HOTKEY_FILE: \\\"/run/base/miner_hotkey\\\"\\n    volumes:\\n      - type: bind\\n        source: miner_hotkey\\n        target: /run/base/miner_hotkey\\n        read_only: true\\n      - type: bind\\n        source: launch_token\\n        target: /run/base/launch_token\\n        read_only: true\\n      - /var/run/dstack.sock:/var/run/dstack.sock\\n\",\"features\":[\"kms\",\"tproxy-net\"],\"gateway_enabled\":true,\"kms_enabled\":true,\"local_key_provider_enabled\":false,\"manifest_version\":2,\"name\":\"\",\"no_instance_id\":false,\"pre_launch_script\":\"#!/bin/bash\\nset -euo pipefail\\nmkdir -p /dstack\\n: > /dstack/launch_token\\nprintf '\\\\x00\\\\x01\\\\x02\\\\x03\\\\x04\\\\x05\\\\x06\\\\x07\\\\x08\\\\x09\\\\x0a\\\\x0b\\\\x0c\\\\x0d\\\\x0e\\\\x0f\\\\x10\\\\x11\\\\x12\\\\x13\\\\x14\\\\x15\\\\x16\\\\x17\\\\x18\\\\x19\\\\x1a\\\\x1b\\\\x1c\\\\x1d\\\\x1e\\\\x1f' > /dstack/miner_hotkey\\nprintf '\\\\xdc\\\\x28\\\\xd9\\\\xa6\\\\xfb\\\\x26\\\\x94\\\\x3b\\\\xf4\\\\x96\\\\xe0\\\\x37\\\\x22\\\\xc5\\\\x33\\\\x77\\\\xb5\\\\x3a\\\\xff\\\\xe9\\\\xec\\\\x84\\\\xc4\\\\xd2\\\\xae\\\\xde\\\\x2f\\\\xdd\\\\x0d\\\\x9c\\\\x48\\\\x21' > /dstack/receipt_sk\\nif chown 65532:65532 /dstack/miner_hotkey /dstack/receipt_sk /dstack/launch_token 2>/dev/null; then\\n  chmod 0400 /dstack/miner_hotkey /dstack/receipt_sk\\n  chmod 0444 /dstack/launch_token\\nelse\\n  chmod 0444 /dstack/miner_hotkey /dstack/receipt_sk /dstack/launch_token\\nfi\\nls -la /dstack/miner_hotkey /dstack/launch_token /dstack/receipt_sk\\necho \\\"pre-launch secrets materialised ok\\\"\\n\",\"public_logs\":true,\"public_s