# Rust
/target/
**/*.rs.bk
*.pdb

# Cargo.lock is tracked for this binary workspace

# Secrets & keys (never commit)
.env
.env.*
!.env.example
*.pem
*.age
*.key
**/wallets/
**/coldkey*
**/hotkey*
**/*secret*
**/*mnemonic*

# OS / editor
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.code-workspace

# Local / ops noise
*.log
tmp/
.cache/
coverage/
lcov.info
.omo/
handoffs/

# Accidental local design/junk at repo root
/test-hero-*.png
/humane-ui-digest.md

# Materialized local env (age-decrypted or copied examples); keep *.env.example
deploy/env/*.env
!deploy/env/*.env.example

# Local e2e runtime (state + cloudflared pid/log); tunnel URL is under deploy/env/
.local/

# Terraform local state / vars (deploy/terraform also has its own .gitignore)
deploy/terraform/.terraform/
deploy/terraform/*.tfstate
deploy/terraform/*.tfstate.*
deploy/terraform/terraform.tfvars
deploy/terraform/*.auto.tfvars
deploy/terraform/tfplan

# Promote-generated updater desired-image sidecars (local/ops)
deploy/pins/*.desired.env

# Miner self-deploy runtime (install.sh)
miner-runtime/
/receipt_sk
# **/*secret* above matches the directory name "secrets"; un-ignore the tree
# then keep only README tracked (materialized key files stay ignored).
!deploy/secrets/
deploy/secrets/*
!deploy/secrets/README.md


__pycache__/
*.pyc
